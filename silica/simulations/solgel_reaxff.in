# ============================================================================
# Sol-Gel Condensation Simulation using ReaxFF
# ============================================================================
# Simulates Si(OH)4 condensation: Si-OH + HO-Si → Si-O-Si + H2O
#
# Usage:
#   mpirun -np 16 lmp -in solgel_reaxff.in -var pH 7.0 -var seed 12345
#
# Variables (set via command line -var):
#   pH    : pH condition label (e.g., 6.0, 6.5, 7.0, 7.5, 8.0)
#   seed  : random seed for velocity initialization
# ============================================================================

# ── Variables ───────────────────────────────────────────────────────────────
variable        pH    index 7.0
variable        seed  index 12345
variable        T_low equal 300.0       # Initial/final temperature (K)
variable        T_hi  equal 2000.0      # Condensation temperature (K)
variable        dt    equal 0.1         # Timestep (fs) — gold standard for ionic ReaxFF

# ── Setup ───────────────────────────────────────────────────────────────────
units           real
atom_style      charge
boundary        p p p

read_data       data.pH_${pH}

# ── Force Field ─────────────────────────────────────────────────────────────
pair_style      reaxff NULL safezone 10.0 mincap 1000
pair_coeff      * * ../potentials/ffield.reax.SiOH Si O H

# Charge equilibration (essential for ReaxFF)
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-5 reaxff

# ── Neighbor List ───────────────────────────────────────────────────────────
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ── Timestep ────────────────────────────────────────────────────────────────
timestep        ${dt}

# ── Output ──────────────────────────────────────────────────────────────────
thermo          500
thermo_style    custom step temp press pe ke etotal density vol atoms



# Bond analysis removed to prevent neighbor list freezing

# Log file
log             out/log.solgel_pH${pH}

# ── Phase 1: Energy Minimization ────────────────────────────────────────────
print           "=== Phase 1: Energy Minimization ==="
minimize        1.0e-4 1.0e-6 1000 10000

# Trajectory dump
dump            traj all custom 2000 out/dump.solgel_pH${pH}.lammpstrj &
                id type x y z q
dump_modify     traj sort id

# ── Phase 2: NVT Equilibration & Compression at 300 K ──────────────────────
print           "=== Phase 2: Compression to Liquid Density at ${T_low} K ==="
velocity        all create ${T_low} ${seed} dist gaussian

# Compress box to target liquid density (~1.2 - 1.5 g/cm^3)
# To achieve this, we shrink the box length to about 27.0 Angstroms.
fix             nvt1 all nvt temp ${T_low} ${T_low} 100.0
fix             deform1 all deform 1 x final 0.0 27.0 y final 0.0 27.0 z final 0.0 27.0 remap x
run             20000    # 2 ps compression
unfix           deform1
run             10000    # 1 ps equilibration after compression
unfix           nvt1

# ── Phase 3: Heating to Condensation Temperature (NVT) ─────────────────────
print           "=== Phase 3: Heating ${T_low} -> ${T_hi} K ==="
fix             nvt_heat all nvt temp ${T_low} ${T_hi} 100.0
run             100000    # 10 ps ramp
unfix           nvt_heat

# ── Phase 4: NVT Condensation at High Temperature ──────────────────────────
print           "=== Phase 4: NVT Condensation at ${T_hi} K ==="
fix             nvt_condense all nvt temp ${T_hi} ${T_hi} 100.0

# Run condensation in stages (40 ps each, total 160 ps)
print           "--- Condensation Stage 1/4 ---"
run             400000
write_restart   out/restart.solgel_pH${pH}.stage1

print           "--- Condensation Stage 2/4 ---"
run             400000
write_restart   out/restart.solgel_pH${pH}.stage2

print           "--- Condensation Stage 3/4 ---"
run             400000
write_restart   out/restart.solgel_pH${pH}.stage3

print           "--- Condensation Stage 4/4 ---"
run             400000
write_restart   out/restart.solgel_pH${pH}.stage4

unfix           nvt_condense

# ── Phase 5: Cooling ───────────────────────────────────────────────────────
print           "=== Phase 5: Cooling ${T_hi} -> ${T_low} K ==="
fix             nvt_cool all nvt temp ${T_hi} ${T_low} 100.0
run             80000    # 8 ps cooling
unfix           nvt_cool

# ── Phase 6: Final Equilibration ───────────────────────────────────────────
print           "=== Phase 6: Final Equilibration at ${T_low} K ==="
fix             nvt_final all nvt temp ${T_low} ${T_low} 100.0
run             20000    # 2 ps
unfix           nvt_final

# ── Output Final Structure ──────────────────────────────────────────────────
write_data      out/data.solgel_pH${pH}.final
write_restart   out/restart.solgel_pH${pH}.final

print           "=== Sol-Gel Simulation Complete for pH ${pH} ==="
