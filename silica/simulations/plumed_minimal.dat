# Minimal PLUMED: just Q6 (skip Q4), smaller pace
si_atoms: GROUP NDX_FILE=si_atoms.ndx NDX_GROUP=si
q6: Q6 SPECIES=si_atoms SWITCH={RATIONAL R_0=3.5 D_MAX=5.0 NN=12 MM=24} MEAN
metad: METAD ARG=q6.mean PACE=100 HEIGHT=1.0 SIGMA=0.05 BIASFACTOR=15 TEMP=1173 FILE=out/HILLS
PRINT ARG=q6.mean STRIDE=100 FILE=out/COLVAR FMT=%8.4f
