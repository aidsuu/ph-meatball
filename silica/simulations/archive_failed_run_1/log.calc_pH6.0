dump_modify     traj sort id

# ── Phase 1: Gradual compression to amorphous SiO₂ density ─────────────────
# After stripping H/H₂O, box is 27³ Å with ~400 atoms → density too low.
# Target: 20³ Å → density ~1.57 g/cm³ (reasonable for porous amorphous SiO₂).
# Compress slowly in 2 stages to avoid atom overlap.
print           "=== Phase 1a: Initial compression (27 → 23 Å) ==="
WARNING: Detected non-ASCII characters in input. Will try to continue by replacing with ASCII equivalents where known. (src/input.cpp:478)
=== Phase 1a: Initial compression (27 �� 23 �) ===
velocity        all create 300.0 ${seed} dist gaussian
velocity        all create 300.0 4240 dist gaussian

fix             nvt_c1 all nvt temp 300.0 300.0 0.1
fix             deform1 all deform 1 x final 0.0 23.0 y final 0.0 23.0 z final 0.0 23.0 remap x
run             10000    # 10 ps

