# ============================================================================
# Calcination Phase Transition using Vashishta + PLUMED2 Metadynamics
# ============================================================================
# Ref: Niu et al., PNAS 2018
# Strategy: NVT throughout to maintain density after compression.
#   NPT causes box expansion at low initial density → atoms too far → NaN.
#   NVT keeps volume fixed after compression to physically reasonable density.
#
# Workflow:
#   1. Compress box to amorphous SiO₂ density (~1.5-2.0 g/cm³)
#   2. Equilibrate at 300 K (NVT)
#   3. Heat 300 K → 1173 K (NVT ramp)
#   4. Equilibrate at 1173 K (NVT)
#   5. Metadynamics calcination at 1173 K (NVT + PLUMED)
# ============================================================================

variable        pH    index 6.0
variable        seed  index 54321

# Units for Vashishta must be metal
units           metal
atom_style      charge
boundary        p p p

# Read the stripped data file (pure SiO₂, no hydrogen)
read_data       out/data.vash_vashishta_pH${pH}

pair_style      vashishta
pair_coeff      * * ../potentials/SiO.1990.vashishta Si O

# Neighbor list
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001   # 1 fs (metal units)

thermo          500
thermo_style    custom step temp press pe ke etotal density vol atoms

log             out/log.calc_pH${pH}

dump            traj all custom 5000 out/dump.calc_pH${pH}.lammpstrj id type x y z
dump_modify     traj sort id

# ── Phase 1: Gradual compression to amorphous SiO₂ density ─────────────────
# After stripping H/H₂O, box is 27³ Å with ~400 atoms → density too low.
# Target: 20³ Å → density ~1.57 g/cm³ (reasonable for porous amorphous SiO₂).
# Compress slowly in 2 stages to avoid atom overlap.
print           "=== Phase 1a: Initial compression (27 → 23 Å) ==="
velocity        all create 300.0 ${seed} dist gaussian

fix             nvt_c1 all nvt temp 300.0 300.0 0.1
fix             deform1 all deform 1 x final 0.0 23.0 y final 0.0 23.0 z final 0.0 23.0 remap x
run             10000    # 10 ps
unfix           deform1
run             5000     # 5 ps relax
unfix           nvt_c1

print           "=== Phase 1b: Final compression (23 → 20 Å) ==="
fix             nvt_c2 all nvt temp 300.0 300.0 0.1
fix             deform2 all deform 1 x final 0.0 20.0 y final 0.0 20.0 z final 0.0 20.0 remap x
run             10000    # 10 ps
unfix           deform2
run             5000     # 5 ps relax
unfix           nvt_c2

# ── Phase 2: Equilibrate at 300 K (NVT) ────────────────────────────────────
print           "=== Phase 2: Equilibration at 300 K ==="
fix             nvt_eq all nvt temp 300.0 300.0 0.1
run             20000    # 20 ps equilibration
unfix           nvt_eq

# ── Phase 3: Heating 300 K → 1173 K (NVT) ─────────────────────────────────
print           "=== Phase 3: Heating 300 K → 1173 K ==="
fix             nvt_heat all nvt temp 300.0 1173.0 0.1
run             50000    # 50 ps heating ramp
unfix           nvt_heat

# ── Phase 4: Equilibrate at 1173 K (NVT) ──────────────────────────────────
print           "=== Phase 4: Equilibration at 1173 K ==="
fix             nvt_hot all nvt temp 1173.0 1173.0 0.1
run             20000    # 20 ps equilibration at target temp
unfix           nvt_hot

# ── Phase 5: Metadynamics Calcination at 1173 K (NVT) ────────────────────
print           "=== Phase 5: Metadynamics Calcination at 1173 K ==="
fix             pl all plumed plumedfile plumed_pH${pH}.dat outfile out/plumed_pH${pH}.out

fix             nvt_calc all nvt temp 1173.0 1173.0 0.1
run             2000000   # 2 ns calcination (accelerated by metadynamics)
unfix           nvt_calc

unfix           pl

# ── Output Final Structure ──────────────────────────────────────────────────
write_data      out/data.calc_pH${pH}.final
write_restart   out/restart.calc_pH${pH}.final

print           "=== Calcination Complete for pH ${pH} ==="
